# storage
CLAWCREW_DB=clawcrew.db

# ---- persistent computers: the celesto OSS runtime on this machine -----------
# local = `pip install celesto && celesto setup`, no account, computers live here.
# cloud = their hosted api, opt-in only (CELESTO_MODE=cloud + CELESTO_API_KEY).
CELESTO_MODE=local
CELESTO_BIN=celesto
CELESTO_API_KEY=
CELESTO_BASE_URL=https://api.celesto.ai/v1
CELESTO_IMAGE=clawcrew/persistent:latest

# ---- ephemeral sandboxes: your own e2b deployment ---------------------------
# e2b's runtime is Apache-2.0 and self-hostable; point this at it. the hosted api
# works too if you set the key, but nothing here defaults to someone else's cloud.
E2B_BASE_URL=http://localhost:3000
E2B_API_KEY=
E2B_TEMPLATE=base

# turn the fallback off in production so a missing runtime fails loudly
CLAWCREW_ALLOW_LOCAL_FALLBACK=true

# ---- self-hosted workflow tools (plugged in, not copied) --------------------
# n8n: the public REST api key from YOUR instance (Settings > n8n API)
CLAWCREW_N8N_BASE_URL=http://localhost:5678
CLAWCREW_N8N_API_KEY=
# dify: an app key (starts with app-) from YOUR instance
CLAWCREW_DIFY_BASE_URL=http://localhost/v1
CLAWCREW_DIFY_API_KEY=
CLAWCREW_DIFY_USER=clawcrew

# scheduling: inproc | celery
CLAWCREW_BROKER=inproc
CELERY_BROKER_URL=
CELERY_QUEUE=clawcrew

# any openai-compatible endpoint. unset -> deterministic model
CLAWCREW_LLM_BASE_URL=
CLAWCREW_LLM_API_KEY=
CLAWCREW_LLM_MODEL=gpt-4.1-mini

# shared bearer token for the http api. /health stays open
CLAWCREW_API_TOKEN=

# review + concurrency
CLAWCREW_REVIEW_MODE=reviewed
CLAWCREW_MAX_PARALLEL=4
CLAWCREW_SANDBOX_TIMEOUT=900
