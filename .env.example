# copy to .env and change what you need. configure.md is the full list with defaults;
# this file is the same list grouped the way a person deploys it.

# ---- storage ----------------------------------------------------------------------
CRITTERTOWN_DB=crittertown.db

# ---- the api ----------------------------------------------------------------------
# shared bearer token. unset means open, which is fine on localhost and wrong on a network
CRITTERTOWN_API_TOKEN=
# the host approval links are built against, otherwise they point at localhost
CRITTERTOWN_PUBLIC_BASE_URL=
# signs approval links. set once and keep it, or old links die on restart
CRITTERTOWN_GATE_SECRET=
CRITTERTOWN_GATE_TTL_HOURS=168

# ---- review + concurrency ---------------------------------------------------------
CRITTERTOWN_REVIEW_MODE=reviewed
CRITTERTOWN_MAX_PARALLEL=4
CRITTERTOWN_SANDBOX_TIMEOUT=900

# ---- model ------------------------------------------------------------------------
# any openai-compatible endpoint. unset -> the deterministic model
CRITTERTOWN_LLM_BASE_URL=
CRITTERTOWN_LLM_API_KEY=
CRITTERTOWN_LLM_MODEL=gpt-4.1-mini

# ---- scheduling: schedule is the deployment path, inproc the dev/test path ---------
CRITTERTOWN_BROKER=schedule
SCHEDULE_BROKER_URL=redis://localhost:6379/0
SCHEDULE_QUEUE=crittertown

# ---- persistent computers: the persistent OSS runtime on this machine --------------
# local = the open source runtime on this machine (crittertown/thirdparty.md names it and
# where to get it), no account, computers live here, and the host needs /dev/kvm.
# cloud = their hosted api, opt-in only (PERSISTENT_MODE=cloud + PERSISTENT_API_KEY).
PERSISTENT_MODE=local
PERSISTENT_BIN=persistent
PERSISTENT_API_KEY=
PERSISTENT_BASE_URL=https://api.machines.internal/v1
PERSISTENT_IMAGE=crittertown/persistent:latest

# ---- ephemeral sandboxes: your own deployment -------------------------------------
# point this at your own instance. the sandbox lifecycle goes over its REST api;
# commands go over envd, which needs the upstream sdk: `pip install "crittertown[ephemeral]"`
EPHEMERAL_BASE_URL=http://localhost:3000
EPHEMERAL_API_KEY=
EPHEMERAL_TEMPLATE=base
# only if your fork renamed the sdk's import
EPHEMERAL_EXEC_MODULE=

# a hosted runtime is opt in: their cloud, their sdk, no byoc
HOSTED_API_KEY=
HOSTED_BASE_URL=
HOSTED_TEMPLATE=

# turn the fallback off in production so a missing runtime fails loudly
CRITTERTOWN_ALLOW_LOCAL_FALLBACK=true

# ---- browser: no account, no key --------------------------------------------------
# local-browser drives any cdp endpoint; container-browser runs chrome in a container;
# none gives an agent no browser at all
CRITTERTOWN_BROWSER_PROVIDER=local-browser
CRITTERTOWN_BROWSER_PROFILE_ROOT=
CRITTERTOWN_CONTAINER_BROWSER_IMAGE=
CRITTERTOWN_BROWSER_CDP=

# ---- credentials: brokered, so an agent never holds a key --------------------------
CREDENTIAL_BROKER_URL=
CREDENTIAL_BROKER_PROXY_URL=
CREDENTIAL_BROKER_TTL_HOURS=24

# ---- the board: your own manage instance ------------------------------------------
CRITTERTOWN_MANAGE_BASE_URL=http://localhost:4000
CRITTERTOWN_MANAGE_API_KEY=

# ---- workflows: your own instance, called by id -----------------------------------
CRITTERTOWN_WORKFLOWS_BASE_URL=http://localhost:7860
CRITTERTOWN_WORKFLOWS_API_KEY=

# ---- toolbox: workflow engines an agent posts to, plugged in not copied -----------
# n8n: the public REST api key from YOUR instance (Settings > n8n API)
CRITTERTOWN_N8N_BASE_URL=http://localhost:5678
CRITTERTOWN_N8N_API_KEY=
# dify: an app key (starts with app-) from YOUR instance
CRITTERTOWN_DIFY_BASE_URL=http://localhost/v1
CRITTERTOWN_DIFY_API_KEY=
CRITTERTOWN_DIFY_USER=crittertown
# firecrawl: the worked example of a toolbox entry, agpl-3.0 so it is called, never copied
CRITTERTOWN_FIRECRAWL_API_KEY=
CRITTERTOWN_FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1

# ---- comms: rooms whose members are agents, over a signed log ---------------------
# custody local = this node mints and holds each agent's key (single box).
# external = only public halves live here and signing happens elsewhere.
CRITTERTOWN_COMMS_CUSTODY=local
# agents are the only first class members of a room unless this is on
CRITTERTOWN_COMMS_HUMANS=false
# a relay every new room is bridged to; empty means local rooms only
CRITTERTOWN_COMMS_RELAY=
CRITTERTOWN_COMMS_RELAY_TRANSPORT=nostr
CRITTERTOWN_COMMS_LIMIT=200

# ---- the morning brief reads the night --------------------------------------------
CRITTERTOWN_BRIEF_START=18
CRITTERTOWN_BRIEF_END=6
